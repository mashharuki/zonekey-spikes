# コピーして .env.local を作る（.env.local は gitignore 済み）。
# 秘密鍵・シード・APIキーはここにだけ置き、コードやコミットには書かない。

# XRPL Testnet の WebSocket エンドポイント。空ならデフォルト wss://s.altnet.rippletest.net:51233
XRPL_TESTNET_URL=

# 02-rlusd-wallet が生成して保存する固定ウォレットのシード（Testnet 専用）。
# 空のままで OK。`pnpm --filter 02-rlusd-wallet start` が空なら新規作成して値を書き込む。絶対に共有・コミットしない。
DONOR_SEED=

# 03-rlusd-escrow 以降で使う受取側（beneficiary）の固定ウォレットのシード（Testnet 専用）。空なら自動生成して書き込む。
BENEFICIARY_SEED=

# 04-voucher-escrow の受給証（RLUSD 裏付け）発行アカウントのシード（Testnet 専用）。空なら自動生成して書き込む。
VOUCHER_ISSUER_SEED=

# 以降の検証で必要になったら追記（値は空のまま共有する）

# 07-privy: Privy ダッシュボードの App ID / App Secret。App Secret はサーバーだけが読む（VITE_ を付けない）
VITE_PRIVY_APP_ID=
PRIVY_APP_SECRET=
# 07-privy: 運営（XRP を送る側）とモック発行者のシード。空なら自動生成して書き込む
OPERATOR_SEED=
MOCK_ISSUER_SEED=

# 11a-check-settle: Todoke の精算口座 S のシード（Testnet 専用）。空なら自動生成して書き込む
SETTLEMENT_SEED=
